{
	"FileVersion": 3,
	"EngineAssociation": "5.2",
	"Category": "Simulation",
	"Description": "Hosts Cosys-AirSim (external/Cosys-AirSim) for the localization simulations: the Antwerp map, generated by maps/build_antwerp_map.py.",
